parameters:
  level: max
  strictRules:
    allRules: true
  fileExtensions:
    - php
  paths:
    - app/
  tmpDir: storage/framework/cache/phpstan
  reportUnmatchedIgnoredErrors: true
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    - '#Access to an undefined property .*\$[a-zA-Z_][a-zA-Z0-9_]*#'

includes:
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - phar://./vendor/phpstan/phpstan/phpstan.phar/conf/bleedingEdge.neon
